# Copy to .env and fill in. .env is gitignored; this file is safe to commit.
#
#   cp .env.example .env
#   set -a; source .env; set +a        # or: node --env-file=.env ...
#
# Nothing in the package itself reads environment variables. These are for the
# examples, the eval harness, and the opt-in live provider tests.

# --- Model (examples) -------------------------------------------------------
# examples/chat.mjs and examples/repo-triage.mjs read these two names.
OPENROUTER_KEY=
MODEL=z-ai/glm-5.3

# --- Model (eval harness) ---------------------------------------------------
# Any OpenAI-compatible endpoint works. The committed comparison used GLM 5.3
# through OpenRouter; leaving prices unset lets the catalog be the source of
# truth (stale .env prices caused a mispriced eval round once).
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=z-ai/glm-5.3
# LLM_PRICE_IN_PER_MTOK=
# LLM_PRICE_OUT_PER_MTOK=
# LLM_PRICE_CACHE_READ=

# --- E2B sandbox ------------------------------------------------------------
E2B_API_KEY=
# E2B_TEMPLATE=base
# E2B_USER=root
# E2B_TIMEOUT_MS=3600000
# E2B_TEMPLATE_MAP={"psf__requests-1963":"anchor-swebench-psf-requests-1963:latest"}

# --- Heyo sandbox (existing provider) ---------------------------------------
# HEYO_TOKEN=
# HEYO_SERVER=https://admin.us5.heyo.work
# HEYO_NAMESPACE=
# HEYO_IMAGE=heyo/bun:latest
# HEYO_SIZE_CLASS=small
# HEYO_DISK_GB=4
#
# Host-side image build (no local Docker): point at a branch with a Dockerfile.
# HEYO_IMAGE=anchor-eval:git
# HEYO_IMAGE_KIND=git
# HEYO_IMAGE_GIT_REPO=https://github.com/hrithikkoduri/anchor-ai-sdk.git
# HEYO_IMAGE_GIT_REF=eval-image
# HEYO_IMAGE_GIT_DOCKERFILE=evals/image/Dockerfile
# HEYO_IMAGE_GIT_CONTEXT=evals/image
# HEYO_IMAGE_SIZE_MB=8192
# HEYO_DISK_GB=10

# --- Opt-in live tests / Docker conformance ---------------------------------
# RUN_LIVE_HEYO_TESTS=1
# RUN_LIVE_E2B_TESTS=1
# ANCHOR_DOCKER_TEST_IMAGE=anchor-conformance
