{
  "name": "@anchor/core",
  "version": "0.0.1",
  "description": "Loop-first, sandbox-first agent framework: engine, tools, LLM client, sandbox adapters.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hrithikkoduri/anchor-sdk.git"
  },
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./sandbox/heyo": {
      "types": "./src/sandbox/heyo/index.ts",
      "default": "./src/sandbox/heyo/index.ts"
    },
    "./sandbox/local": {
      "types": "./src/sandbox/local/index.ts",
      "default": "./src/sandbox/local/index.ts"
    },
    "./sandbox/docker": {
      "types": "./src/sandbox/docker/index.ts",
      "default": "./src/sandbox/docker/index.ts"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "default": "./src/testing.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@heyocomputer/hws": ">=0.4",
    "vitest": ">=3"
  },
  "peerDependenciesMeta": {
    "@heyocomputer/hws": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@heyocomputer/hws": "^0.4.0",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
