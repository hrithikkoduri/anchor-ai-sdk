{
  "name": "@anchor/core",
  "version": "0.0.1",
  "description": "Loop-first, sandbox-first agent framework: engine, tools, LLM client, sandbox adapters.",
  "type": "module",
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./sandbox/heyo": {
      "types": "./src/sandbox/heyo.ts",
      "default": "./src/sandbox/heyo.ts"
    },
    "./sandbox/local": {
      "types": "./src/sandbox/local.ts",
      "default": "./src/sandbox/local.ts"
    },
    "./sandbox/docker": {
      "types": "./src/sandbox/docker.ts",
      "default": "./src/sandbox/docker.ts"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "default": "./src/testing.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@heyocomputer/hws": "^0.4.0"
  },
  "peerDependencies": {
    "vitest": ">=3"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
