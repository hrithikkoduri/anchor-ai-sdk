{
  "name": "anchor-ai-sdk",
  "version": "0.8.11",
  "description": "Loop-first, sandbox-first agent harness SDK: engine, tools, LLM client, sandbox adapters.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hrithikkoduri/anchor-ai-sdk.git"
  },
  "homepage": "https://anchor-sdk.dev",
  "keywords": [
    "ai",
    "agent",
    "agents",
    "framework",
    "sandbox",
    "llm",
    "coding-agent",
    "microvm"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "anchor": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sandbox/heyo": {
      "types": "./dist/sandbox/heyo/index.d.ts",
      "default": "./dist/sandbox/heyo/index.js"
    },
    "./sandbox/local": {
      "types": "./dist/sandbox/local/index.d.ts",
      "default": "./dist/sandbox/local/index.js"
    },
    "./sandbox/docker": {
      "types": "./dist/sandbox/docker/index.d.ts",
      "default": "./dist/sandbox/docker/index.js"
    },
    "./sandbox/e2b": {
      "types": "./dist/sandbox/e2b/index.d.ts",
      "default": "./dist/sandbox/e2b/index.js"
    },
    "./lsp": {
      "types": "./dist/lsp/index.d.ts",
      "default": "./dist/lsp/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build && node scripts/verify-dist-exports.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2b:template": "node scripts/build-e2b-template.mjs",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@heyocomputer/hws": ">=0.4",
    "e2b": "^2.56",
    "vitest": ">=3"
  },
  "peerDependenciesMeta": {
    "@heyocomputer/hws": {
      "optional": true
    },
    "e2b": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@heyocomputer/hws": "^0.4.0",
    "@types/node": "^26.6.5",
    "e2b": "^2.56.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
